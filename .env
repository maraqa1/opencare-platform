PLATFORM_NAME=opencare-platform
ENVIRONMENT=prod

BASE_DOMAIN=opendatalake.com

PORTAL_HOST=opencare.opendatalake.com
API_HOST=api.opencare.opendatalake.com
AUTH_HOST=auth.opencare.opendatalake.com
ANALYTICS_HOST=analytics.opencare.opendatalake.com

TLS_EMAIL=admin@opendatalake.com

POSTGRES_DB=opencare
POSTGRES_USER=opencare
POSTGRES_PASSWORD=opencare2025!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

RAW_SCHEMA=raw
STAGING_SCHEMA=staging
ANALYTICS_SCHEMA=analytics
DICTIONARY_SCHEMA=dictionary
OUTPUT_SCHEMA=output

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=opencare2025!
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_RAW=raw
S3_BUCKET_STATE=state
S3_BUCKET_ARTIFACTS=artifacts
S3_BUCKET_REPORTS=reports
S3_PATH_STYLE=true

REDIS_URL=redis://redis:6379/0

KEYCLOAK_REALM=opencare
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=opencare2025!

OIDC_CLIENT_ID_PORTAL=portal
OIDC_CLIENT_SECRET_PORTAL=opencare2025!
OIDC_CLIENT_ID_BACKEND=backend
OIDC_CLIENT_SECRET_BACKEND=opencare2025!

OIDC_ISSUER_URL=https://auth.opencare.opendatalake.com/realms/opencare

SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=opencare2025!
SUPERSET_SECRET_KEY=opencare_secret_key

SUPERSET_METADATA_DB=superset_meta
SUPERSET_METADATA_USER=superset
SUPERSET_METADATA_PASSWORD=opencare2025!

AIRBYTE_VERSION=latest
AIRBYTE_NAMESPACE=airbyte

MYSQL_SOURCE_HOST=CHANGE_ME
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_DB=CHANGE_ME
MYSQL_SOURCE_USER=CHANGE_ME
MYSQL_SOURCE_PASSWORD=CHANGE_ME

DBT_TARGET=prod
DBT_THREADS=4

BED_FORECAST_CRON=0 * * * *
BED_ANOMALY_CRON=15 * * * *

RUNTIME_DB_HOST=postgres
RUNTIME_DB_USER=opencare
RUNTIME_DB_PASSWORD=opencare2025!

SESSION_SECRET=opencare_session_secret
FILE_SIGNING_KEY=opencare_file_key