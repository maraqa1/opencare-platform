{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "kind",
    "canonical",
    "deprecated",
    "superseded_by",
    "rule",
    "validation_rule"
  ],
  "properties": {
    "kind": {
      "const": "DeprecatedScreenLayoutsContract"
    },
    "canonical": {
      "const": false
    },
    "deprecated": {
      "const": true
    },
    "superseded_by": {
      "const": "screens/layout_zones.yaml"
    },
    "rule": {
      "type": "string"
    },
    "validation_rule": {
      "type": "string"
    },
    "legacy_screen_ids": {
      "type": "array"
    },
    "canonical_dashboard_ids": {
      "type": "array"
    }
  },
  "additionalProperties": true
}